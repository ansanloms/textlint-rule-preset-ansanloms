{
  "name": "@ansanloms/textlint-rule-preset-ansanloms",
  "version": "0.1.0",
  "description": "textlint rule preset for ansanloms",
  "keywords": [
    "preset",
    "textlint",
    "textlintrule"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansanloms/textlint-rule-preset-ansanloms.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test '*.test.ts'",
    "lint": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@proofdict/textlint-rule-proofdict": "3.1.2",
    "@textlint-ja/textlint-rule-preset-ai-writing": "1.7.0",
    "textlint-rule-preset-ja-spacing": "3.0.3",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "textlint-rule-preset-jtf-style": "3.0.3"
  },
  "devDependencies": {
    "@textlint/kernel": "15.8.0",
    "@textlint/textlint-plugin-markdown": "15.8.0",
    "@types/node": "24.19.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  }
}
