{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "version": "0.0.1",
  "exclude": ["examples/"],
  "fmt": {
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "plugins": ["jsr:@aireone/deno-lint-curly@0.2.0"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@textlint/kernel": "npm:@textlint/kernel@15.8.0",
    "@textlint/textlint-plugin-markdown": "npm:@textlint/textlint-plugin-markdown@15.8.0"
  },
  "tasks": {
    "test": "deno test -A --parallel --coverage",
    "check": "deno check **/*.ts",
    "lint": "deno lint && deno fmt --check",
    "fix": "deno lint --fix && deno fmt",
    "update": "deno run --no-lock --allow-env --allow-read --allow-write=. --allow-net --allow-run=git,deno jsr:@molt/cli@0.19.8 --no-lock deps/*/mod.ts deps/@*/*/mod.ts",
    "update:write": "deno task update --write"
  }
}
